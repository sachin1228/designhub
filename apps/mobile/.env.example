# Required for Expo Router to find the app directory in a monorepo/workspace setup.
# Without this, bundling fails with "Invalid call: process.env.EXPO_ROUTER_APP_ROOT".
EXPO_ROUTER_APP_ROOT=app

# Base URL of your DraftHub web API (no trailing slash).
# For local development: use your machine's LAN IP, not localhost —
# the phone needs to reach your computer over the network.
#   e.g. EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:3000
# For production:
#   EXPO_PUBLIC_API_BASE_URL=https://your-drafthub-domain.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
