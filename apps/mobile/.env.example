# Base URL of your deployed Next.js web app (no trailing slash)
# For local dev on Replit, use your .replit.dev domain
EXPO_PUBLIC_API_BASE_URL=https://your-app.replit.dev

# Supabase project settings (same as your web app's NEXT_PUBLIC_ vars)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
